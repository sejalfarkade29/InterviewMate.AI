# Copy to .env.local (optional - the defaults below already work).
# Where the Next.js server forwards /api/* requests (your FastAPI backend):
BACKEND_URL=http://127.0.0.1:8000
# Live voice uses a WebSocket straight to the backend (Next.js cannot proxy WebSockets in dev).
# Leave empty to use ws://<current host>:8000
NEXT_PUBLIC_WS_URL=
# Only set this if you want the browser to call the API directly instead of through Next.js:
# NEXT_PUBLIC_API_URL=http://localhost:8000
